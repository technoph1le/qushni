# Qo'shni backend settings. Copy to .env ("npm run setup" in the repo root does it) and fill in. Never commit .env.
PORT=8787

# --- Supabase (Project Settings → API Keys) ---
SUPABASE_URL=
# The SECRET key (sb_secret_… or legacy "service_role"). It bypasses row-level security: server only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram bot from @BotFather (use a separate dev bot on your own computer) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string Telegram sends back on every webhook call. "npm run setup" generates it.
TELEGRAM_WEBHOOK_SECRET=

# --- Payments (leave empty until payments start) ---
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=true
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
