# ===== Qo'shni backend settings. These are secrets: never commit or share the real .env. =====
PORT=8787
# Website address(es), comma-separated. Used for CORS and payment return links.
FRONTEND_URL=http://localhost:5173
# Production only: public HTTPS address of this backend, used by "npm run telegram:webhook".
# Locally, "npm run dev" in the project root points the bot at your tunnel automatically.
PUBLIC_API_URL=

# Supabase → Project Settings → API Keys
SUPABASE_URL=
# The SECRET key (sb_secret_… or legacy "service_role"). Backend only!
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot from @BotFather. Use a separate dev bot on your computer (docs/DEPLOYMENT.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string Telegram sends back on every webhook call. "npm run setup" generates it.
TELEGRAM_WEBHOOK_SECRET=

# Payme Business (cash register). Leave empty to disable Payme.
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=true

# Click (merchant service). Leave empty to disable Click.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
