{
  "name": "qoshni-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:local": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "telegram:webhook": "tsx --env-file=.env scripts/set-webhook.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.1",
    "@supabase/supabase-js": "^2.45.4",
    "hono": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
