# ===== Qo'shni settings. Copy to .env.local ("npm run setup" does it) and fill in. Never commit .env.local. =====
# On Vercel, set the same names in Settings → Environment Variables. The Supabase integration adds the first four.

# --- Supabase (Project Settings → API Keys) ---
# Public: these two end up in the browser, which is expected.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. SUPABASE_URL can be left empty if it equals NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
# The SECRET key (sb_secret_… or legacy "service_role"). Never give it a NEXT_PUBLIC_ name!
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram bot from @BotFather (use a separate dev bot on your own computer) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string Telegram sends back on every webhook call. "npm run setup" generates it.
TELEGRAM_WEBHOOK_SECRET=

# --- Site address for link previews and the sitemap (optional; Vercel's domain is used if empty) ---
NEXT_PUBLIC_SITE_URL=

# --- Payments (leave empty until payments start) ---
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=true
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
