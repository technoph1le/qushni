# Qo'shni frontend settings. Copy to .env.local ("npm run setup" in the repo root does it). Never commit .env.local.

# --- Supabase (Project Settings → API Keys). Public: these end up in the browser, which is expected. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Where the backend runs. /api/* on this site is forwarded there. ---
API_URL=http://localhost:8787

# --- Site address for link previews and the sitemap (optional; Vercel's domain is used if empty) ---
NEXT_PUBLIC_SITE_URL=
