# ===== Qo'shni website settings. These values end up in the browser, so they are public by design. =====
# Supabase → Project Settings → API Keys. Leave both empty to run the dev server on demo data.
VITE_SUPABASE_URL=
# The PUBLISHABLE key (sb_publishable_… or legacy "anon"). Never the secret key!
VITE_SUPABASE_ANON_KEY=
# Backend address. "/api" goes through the dev server (also works on share links).
# In production set the full URL, e.g. https://api.qoshni.uz
VITE_API_URL=/api
# Public address of the website, used for link previews (no trailing slash)
VITE_SITE_URL=http://localhost:5173
