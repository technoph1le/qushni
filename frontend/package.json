{
  "name": "qoshni",
  "private": true,
  "description": "Qo'shni — roommate and room finder for Uzbekistan. A Mir2Dos product.",
  "scripts": {
    "setup": "npm install && node scripts/setup-env.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev -p 5173",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test src/server/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "telegram:webhook": "tsx --env-file=.env.local scripts/set-webhook.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "hono": "^4.6.3",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
